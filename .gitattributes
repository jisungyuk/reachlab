# Normalize line endings across platforms
* text=auto

# Python and text files always LF
*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf

# Binary files — no line ending conversion
*.stl    binary
*.png    binary
*.jpg    binary
*.ico    binary
